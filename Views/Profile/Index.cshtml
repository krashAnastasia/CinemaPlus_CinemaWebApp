@model ProfileViewModel
@{
    ViewData["Title"] = "Кабінет";
}

<section class="profile-page">
    <div class="profile-container">
        <div class="profile-header">
            <h1>МІЙ КАБІНЕТ</h1>
            <span class="bonus-pill">@Model.BonusLabel</span>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="form-validation-summary profile-page__status-message">
                <p>@Model.StatusMessage</p>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="form-validation-summary profile-page__error-message">
                <p>@Model.ErrorMessage</p>
            </div>
        }

        <div class="profile-top">
            <div class="profile-info" id="profile-card" data-profile-root>
                <div class="avatar-wrapper">
                    <form asp-controller="Profile"
                          asp-action="UpdateProfilePhoto"
                          method="post"
                          enctype="multipart/form-data"
                          class="profile-photo-form"
                          data-profile-photo-form>
                        <input type="file"
                               id="profilePhotoUpload"
                               name="profilePhotoFile"
                               accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                               class="profile-photo-form__input"
                               data-profile-photo-input />
                    </form>

                    @if (!Model.UseDefaultProfilePhoto && !string.IsNullOrWhiteSpace(Model.ProfilePhotoPath))
                    {
                        <img src="@Model.ProfilePhotoPath" alt="@Model.FullName" class="profile-photo" />
                    }
                    else
                    {
                        <div class="profile-photo profile-photo--placeholder" aria-label="Фото профілю">
                            <i class="fa-solid fa-circle-user"></i>
                        </div>
                    }
                    <label for="profilePhotoUpload" class="icon-btn avatar-edit" aria-label="Завантажити фото профілю">
                        <i class="fa-solid fa-pen"></i>
                    </label>
                </div>

                <article class="profile-card @(Model.IsEditingProfile ? "is-hidden" : null)" data-profile-display>
                    <button type="button" class="icon-btn card-edit" aria-label="Редагувати дані профілю" data-profile-edit-open>
                        <i class="fa-solid fa-pen"></i>
                    </button>
                    <h2>@Model.FullName</h2>
                    <p class="profile-meta">@Model.Email</p>
                    <p class="profile-meta">@Model.PhoneDisplay</p>
                </article>

                <form asp-controller="Profile"
                      asp-action="UpdateProfile"
                      method="post"
                      class="profile-card profile-edit-card @(Model.IsEditingProfile ? "is-visible" : null)"
                      data-profile-form
                      novalidate>
                    <div asp-validation-summary="ModelOnly" class="form-validation-summary"></div>

                    <div class="profile-edit-card__field">
                        <label asp-for="FullName" class="profile-edit-card__label">Ім'я та прізвище</label>
                        <input asp-for="FullName" class="form-control profile-edit-card__input" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="profile-edit-card__field">
                        <label asp-for="Email" class="profile-edit-card__label">Електронна пошта</label>
                        <input asp-for="Email" class="form-control profile-edit-card__input" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="profile-edit-card__field">
                        <label asp-for="Phone" class="profile-edit-card__label">Телефон</label>
                        <input asp-for="Phone" class="form-control profile-edit-card__input" placeholder="+380..." />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <div class="profile-edit-card__actions">
                        <button type="submit" class="button-primary profile-edit-card__action-btn">ЗБЕРЕГТИ</button>
                        <button type="button" class="button-light profile-edit-card__action-btn" data-profile-edit-cancel>СКАСУВАТИ</button>
                    </div>
                </form>
            </div>

            <div class="profile-actions">
                <a href="#profile-tickets" class="pill-btn secondary-btn">МОЇ БІЛЕТИ</a>
                <a href="#profile-card" class="pill-btn secondary-btn">ДАНІ ПРОФІЛЮ</a>
            </div>
        </div>

        <section class="tickets-section" id="profile-tickets">
            <h2>МОЇ БІЛЕТИ</h2>

            @if (Model.Tickets.Count == 0)
            {
                <p class="shell-placeholder">У вашому кабінеті ще немає придбаних квитків.</p>
            }
            else
            {
                <div class="profile-tickets-grid">
                    @foreach (var ticket in Model.Tickets)
                    {
                        <article class="profile-ticket-card">
                            <div class="profile-ticket-card__poster-wrap">
                                <img src="@ticket.PosterPath" alt="@ticket.MovieTitle" class="profile-ticket-card__poster">
                                <div class="profile-ticket-card__overlay">
                                    <h3 class="profile-ticket-card__title">@ticket.MovieTitle</h3>
                                    <div class="profile-ticket-card__meta">
                                        <span>@ticket.DateText</span>
                                        <span>@ticket.TimeText</span>
                                    </div>
                                </div>
                            </div>

                            <p class="profile-ticket-card__status @(ticket.IsCancelled ? "profile-ticket-card__status--cancelled" : null)">@ticket.StatusText</p>
                            <p class="profile-ticket-card__seats">@ticket.SeatSummaryText.ToUpper(CinemaPresentationHelper.UkrainianCulture)</p>

                            <div class="profile-ticket-card__actions">
                                @if (ticket.CanCancel)
                                {
                                    <form asp-controller="Profile" asp-action="CancelBooking" asp-route-bookingId="@ticket.BookingId" method="post">
                                        <button type="submit" class="button-light profile-ticket-card__button">ПОВЕРНУТИ</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="button-light profile-ticket-card__button profile-ticket-card__button--disabled">СКАСОВАНО</span>
                                }

                                <a asp-controller="Tickets" asp-action="Details" asp-route-id="@ticket.BookingId" class="button-primary profile-ticket-card__button">ДЕТАЛІ</a>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>

        <div class="back-button-wrapper">
            <a asp-controller="Home" asp-action="Index" class="btn-back">НА ГОЛОВНУ</a>
        </div>
    </div>
</section>
