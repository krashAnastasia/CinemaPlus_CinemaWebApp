@{
    var title = ViewData["Title"] as string ?? "Адмін";
    var activeSection = ViewData["AdminSection"] as string ?? string.Empty;
    string Active(string section) => activeSection == section ? "active" : string.Empty;
}
<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="~/source/logo-blue-dark-fav.png" />
    <title>@title - Кінотеатр</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        .admin-navbar-logo {
            height: 36px;
            width: auto;
            display: block;
        }
    </style>
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" asp-controller="Admin" asp-action="Films">
                <img src="~/source/logo-nav.png" alt="CinemaPlus" class="admin-navbar-logo" />
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNavbarNav" aria-controls="adminNavbarNav" aria-expanded="false" aria-label="Відкрити навігацію">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="adminNavbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item"><a class="nav-link @Active("films")" asp-controller="Admin" asp-action="Films">Фільми</a></li>
                    <li class="nav-item"><a class="nav-link @Active("sessions")" asp-controller="Admin" asp-action="Sessions">Сеанси</a></li>
                    <li class="nav-item"><a class="nav-link @Active("halls")" asp-controller="Admin" asp-action="Halls">Зали</a></li>
                    <li class="nav-item"><a class="nav-link @Active("bookings")" asp-controller="Admin" asp-action="Bookings">Бронювання</a></li>
                    <li class="nav-item"><a class="nav-link @Active("reports")" asp-controller="Admin" asp-action="Reports">Звіти</a></li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle @Active("stats")" href="#" id="statsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Статистика
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="statsDropdown">
                            <li><a class="dropdown-item" asp-controller="Admin" asp-action="PopularFilms">Популярність фільмів</a></li>
                            <li><a class="dropdown-item" asp-controller="Admin" asp-action="Revenue">Доходи за період</a></li>
                        </ul>
                    </li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">До сайту</a></li>
                </ul>
            </div>
        </div>
    </nav>

    @RenderBody()

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
