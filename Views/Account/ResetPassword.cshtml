@model ResetPasswordViewModel

@{
    ViewData["Title"] = "Новий пароль";
}

<section class="register-page">
    <div class="register-hero">
        <div class="register-hero__overlay">
            <div class="register-card auth-card--wide">
                <h1 class="register-card__title">СТВОРЕННЯ НОВОГО ПАРОЛЯ</h1>

                @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
                {
                    <div class="auth-status-message" role="status">@Model.StatusMessage</div>
                }

                @if (Model.IsTokenValid)
                {
                    <form asp-controller="Account" asp-action="ResetPassword" method="post" class="register-form" novalidate>
                        @Html.AntiForgeryToken()
                        <input asp-for="Email" type="hidden" />
                        <input asp-for="Token" type="hidden" />

                        <div asp-validation-summary="ModelOnly" class="auth-validation"></div>

                        <div class="register-form__field">
                            <input asp-for="Password" type="password" placeholder="новий пароль" autocomplete="new-password" />
                            <span asp-validation-for="Password" class="auth-validation"></span>
                        </div>

                        <div class="register-form__field">
                            <input asp-for="ConfirmPassword" type="password" placeholder="підтвердити новий пароль" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="auth-validation"></span>
                        </div>

                        <div class="register-form__actions">
                            <a asp-controller="Account" asp-action="Login" class="button-dark">ДО ВХОДУ</a>
                            <button type="submit" class="button-primary">ОНОВИТИ ПАРОЛЬ</button>
                        </div>
                    </form>
                }
                else
                {
                    <div class="auth-preview-card auth-preview-card--compact">
                        <p>Запросіть новий лист для відновлення, щоб отримати актуальне посилання.</p>
                        <a asp-controller="Account" asp-action="ForgotPassword" class="button-primary auth-preview-card__button">ЗАПИТАТИ НОВИЙ ЛИСТ</a>
                    </div>
                }
            </div>
        </div>
    </div>
</section>
