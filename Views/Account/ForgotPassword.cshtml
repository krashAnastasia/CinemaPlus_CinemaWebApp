@model ForgotPasswordViewModel

@{
    ViewData["Title"] = "Відновлення пароля";
}

<section class="signin-page">
    <div class="signin-hero">
        <div class="signin-hero__overlay">
            <div class="signin-card auth-card--wide">
                <h1 class="signin-card__title">ВІДНОВЛЕННЯ ПАРОЛЯ</h1>

                @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
                {
                    <div class="auth-status-message" role="status">@Model.StatusMessage</div>
                }

                <form asp-controller="Account" asp-action="ForgotPassword" method="post" class="signin-form" novalidate>
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="auth-validation"></div>

                    <div class="signin-form__field">
                        <input asp-for="Email" type="email" placeholder="електронна пошта" autocomplete="email" />
                        <span asp-validation-for="Email" class="auth-validation"></span>
                    </div>

                    <div class="signin-form__actions signin-form__actions--single">
                        <button type="submit" class="button-primary">НАДІСЛАТИ ЛИСТ</button>
                    </div>
                </form>

                @if (Model.HasEmulatedEmail)
                {
                    <section class="auth-preview-card" aria-label="Емуляція листа відновлення">
                        <p class="auth-preview-card__eyebrow">Емуляція листа</p>
                        <h2>@Model.EmulatedEmailSubject</h2>
                        <p><strong>Кому:</strong> @Model.EmulatedEmailRecipient</p>
                        <p>@Model.EmulatedEmailBody</p>
                        <p><strong>Дійсне до:</strong> @Model.ExpiresAtText</p>
                        <a href="@Model.ResetLink" class="button-primary auth-preview-card__button">ПЕРЕЙТИ ДО ЗМІНИ ПАРОЛЯ</a>
                    </section>
                }
            </div>
        </div>
    </div>
</section>
