@model AdminHallFormViewModel
@{
    Layout = "_AdminLayout";
}

<div class="container mt-4 mb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <h1 class="mb-0">@Model.PageTitle</h1>
        <a asp-controller="Admin" asp-action="Halls" class="btn btn-outline-secondary">До списку залів</a>
    </div>

    @if (Model.HasProtectedBookings)
    {
        <div class="alert alert-warning">
            Для цього залу вже існують бронювання. Назву та технологію можна оновлювати, але зміну кількості рядів або місць сервер не дозволить.
        </div>
    }

    <form asp-controller="Admin" asp-action="@Model.FormAction" asp-route-id="@Model.Id" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="card shadow-sm">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label">Назва залу</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Technology" class="form-label">Технологія</label>
                        <input asp-for="Technology" class="form-control" placeholder="2D, 3D, IMAX..." />
                        <span asp-validation-for="Technology" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="RowsCount" class="form-label">Кількість рядів</label>
                        <input asp-for="RowsCount" class="form-control" type="number" min="1" max="32" data-layout-field />
                        <span asp-validation-for="RowsCount" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="SeatsPerRow" class="form-label">Місць у ряду</label>
                        <input asp-for="SeatsPerRow" class="form-control" type="number" min="1" max="40" data-layout-field />
                        <span asp-validation-for="SeatsPerRow" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mt-4 p-3 rounded bg-light border">
                    <p class="mb-1 fw-semibold">Попередній розрахунок</p>
                    <p class="mb-0 text-muted">Усього місць: <span data-total-seats>@Model.TotalSeats</span></p>
                </div>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-3">
            <button type="submit" class="btn btn-dark">@Model.SubmitButtonText</button>
            <a asp-controller="Admin" asp-action="Halls" class="btn btn-outline-secondary">Скасувати</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (() => {
            const fields = Array.from(document.querySelectorAll('[data-layout-field]'));
            const output = document.querySelector('[data-total-seats]');

            if (fields.length !== 2 || !output) {
                return;
            }

            const render = () => {
                const [rowsField, seatsField] = fields;
                const rows = Number(rowsField.value || 0);
                const seats = Number(seatsField.value || 0);
                output.textContent = String(Math.max(0, rows) * Math.max(0, seats));
            };

            fields.forEach((field) => field.addEventListener('input', render));
            render();
        })();
    </script>
}
