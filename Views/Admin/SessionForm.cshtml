@model AdminSessionFormViewModel
@{
    Layout = "_AdminLayout";
}

<div class="container mt-4 mb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <h1 class="mb-0">@Model.PageTitle</h1>
        <a asp-controller="Admin" asp-action="Sessions" class="btn btn-outline-secondary">До списку сеансів</a>
    </div>

    @if (Model.HasBookings)
    {
        <div class="alert alert-warning">
            Для цього сеансу вже існують бронювання. Щоб не зламати історію квитків, сервер не дозволить змінювати фільм або зал.
        </div>
    }

    <form asp-controller="Admin" asp-action="@Model.FormAction" asp-route-id="@Model.Id" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="card shadow-sm">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FilmId" class="form-label">Фільм</label>
                        <select asp-for="FilmId" class="form-select">
                            <option value="">Оберіть фільм</option>
                            @foreach (var film in Model.Films)
                            {
                                <option value="@film.Id">@film.Label</option>
                            }
                        </select>
                        <span asp-validation-for="FilmId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="HallId" class="form-label">Зал</label>
                        <select asp-for="HallId" class="form-select">
                            <option value="">Оберіть зал</option>
                            @foreach (var hall in Model.Halls)
                            {
                                <option value="@hall.Id">@hall.Label</option>
                            }
                        </select>
                        <span asp-validation-for="HallId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="SessionTime" class="form-label">Дата і час</label>
                        <input asp-for="SessionTime" type="datetime-local" class="form-control" />
                        <span asp-validation-for="SessionTime" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Price" class="form-label">Ціна</label>
                        <input asp-for="Price" type="number" step="0.01" min="1" class="form-control" />
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-3">
            <button type="submit" class="btn btn-dark">@Model.SubmitButtonText</button>
            <a asp-controller="Admin" asp-action="Sessions" class="btn btn-outline-secondary">Скасувати</a>
        </div>
    </form>
</div>
