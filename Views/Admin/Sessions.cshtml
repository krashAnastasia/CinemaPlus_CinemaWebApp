@model AdminSessionListViewModel
@{
    Layout = "_AdminLayout";
}

<div class="container mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <h1 class="mb-0">Сеанси</h1>
        <a asp-controller="Admin" asp-action="AddSession" class="btn btn-dark">Додати сеанс</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="alert alert-success" role="status">@Model.StatusMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    <form method="get" asp-controller="Admin" asp-action="Sessions" class="row g-3 align-items-end mb-4">
        <div class="col-12 col-md-3">
            <label for="hallId" class="form-label">Зал</label>
            <select id="hallId" name="hallId" class="form-select">
                <option value="">Усі</option>
                @foreach (var hall in Model.Halls)
                {
                    <option value="@hall.Id" selected="@(Model.HallId == hall.Id ? "selected" : null)">@hall.Name (@hall.Technology)</option>
                }
            </select>
        </div>

        <div class="col-6 col-md-2">
            <label for="priceMin" class="form-label">Ціна від</label>
            <input id="priceMin" name="priceMin" type="number" step="0.01" min="0" value="@Model.PriceMin" class="form-control" />
        </div>

        <div class="col-6 col-md-2">
            <label for="priceMax" class="form-label">Ціна до</label>
            <input id="priceMax" name="priceMax" type="number" step="0.01" min="0" value="@Model.PriceMax" class="form-control" />
        </div>

        <div class="col-6 col-md-2">
            <label for="startDate" class="form-label">Дата від</label>
            <input id="startDate" name="startDate" type="date" value="@Model.StartDate?.ToString("yyyy-MM-dd")" class="form-control" />
        </div>

        <div class="col-6 col-md-2">
            <label for="endDate" class="form-label">До</label>
            <input id="endDate" name="endDate" type="date" value="@Model.EndDate?.ToString("yyyy-MM-dd")" class="form-control" />
        </div>

        <div class="col-6 col-md-2">
            <label for="sortBy" class="form-label">Сортувати</label>
            <select id="sortBy" name="sortBy" class="form-select">
                <option value="session_time" selected="@(Model.SortBy == "session_time" ? "selected" : null)">Дата і час</option>
                <option value="price" selected="@(Model.SortBy == "price" ? "selected" : null)">Ціна</option>
                <option value="hall" selected="@(Model.SortBy == "hall" ? "selected" : null)">Зал</option>
                <option value="film_title" selected="@(Model.SortBy == "film_title" ? "selected" : null)">Фільм</option>
            </select>
        </div>

        <div class="col-6 col-md-2">
            <label for="sortDir" class="form-label">Напрям</label>
            <select id="sortDir" name="sortDir" class="form-select">
                <option value="asc" selected="@(Model.SortDir == "asc" ? "selected" : null)">За зростанням</option>
                <option value="desc" selected="@(Model.SortDir == "desc" ? "selected" : null)">За спаданням</option>
            </select>
        </div>

        <div class="col-12 col-md-auto d-flex gap-2">
            <button type="submit" class="btn btn-dark">ЗАСТОСУВАТИ</button>
            <a asp-controller="Admin" asp-action="Sessions" class="btn btn-outline-secondary">СКИНУТИ</a>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Фільм</th>
                    <th>Дата і час</th>
                    <th>Зал</th>
                    <th>Технологія</th>
                    <th>Ціна</th>
                    <th>Бронювання</th>
                    <th>Продано місць</th>
                    <th>Дії</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Sessions.Count == 0)
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-4">Сеанси за вибраними фільтрами не знайдено.</td>
                    </tr>
                }
                else
                {
                    @foreach (var session in Model.Sessions)
                    {
                        <tr>
                            <td>@session.Id</td>
                            <td>@session.FilmTitle</td>
                            <td>@session.SessionTime.ToString("dd.MM.yyyy HH:mm", CinemaPresentationHelper.UkrainianCulture)</td>
                            <td>@session.HallName</td>
                            <td>@session.Technology</td>
                            <td>@session.Price.ToString("0.00", CinemaPresentationHelper.UkrainianCulture) грн</td>
                            <td>@session.BookingsCount</td>
                            <td>@session.SoldSeatsCount</td>
                            <td class="text-nowrap">
                                <a asp-controller="Admin" asp-action="EditSession" asp-route-id="@session.Id" class="btn btn-sm btn-outline-primary me-1" title="Редагувати">
                                    <i class="fa-solid fa-pencil"></i>
                                </a>
                                <form asp-controller="Admin" asp-action="DeleteSession" asp-route-id="@session.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Видалити" onclick="return confirm('Ви впевнені, що хочете видалити цей сеанс?');">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
