@model AdminPopularFilmsStatsViewModel
@{
    Layout = "_AdminLayout";
}

<div class="container mt-4">
    <h1 class="mb-4">Популярність фільмів</h1>

    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead class="table-light">
                <tr>
                    <th>Фільм</th>
                    <th>Жанр</th>
                    <th>Кількість сеансів</th>
                    <th>Кількість бронювань</th>
                    <th>Продано місць</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">Статистика поки що відсутня.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.FilmTitle</td>
                            <td>@item.Genre</td>
                            <td>@item.SessionsCount</td>
                            <td>@item.BookingsCount</td>
                            <td>@item.SoldSeatsCount</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
