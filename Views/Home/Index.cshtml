@model MovieCatalogueViewModel
@{
    ViewData["Title"] = "Головна";
}

@if (Model.ShowHero)
{
    <section class="hero-section" aria-label="Головний банер">
        <div class="hero-slider" data-hero-slider data-hero-interval="3000">
            <div class="hero-slider__slides" aria-live="polite">
                <figure class="hero-slide" data-hero-slide>
                    <img src="~/source/hero-img.jpg" alt="Головний банер CinemaPlus" class="hero-image" />
                </figure>
                <figure class="hero-slide" data-hero-slide>
                    <img src="~/source/twilight-hero.webp" alt="Банер фільму Сутінки" class="hero-image" />
                </figure>
                <figure class="hero-slide" data-hero-slide>
                    <img src="~/source/Avengers_Endgame_hero.webp" alt="Банер фільму Avengers Endgame" class="hero-image" />
                </figure>
                <figure class="hero-slide" data-hero-slide>
                    <img src="~/source/avatar_hero.webp" alt="Банер фільму Avatar" class="hero-image" />
                </figure>
            </div>

            <div class="hero-slider__overlay"></div>

            <div class="hero-slider__indicators" aria-label="Навігація банера">
                <button type="button" class="hero-slider__dot" data-hero-dot aria-label="Слайд 1" aria-current="false"></button>
                <button type="button" class="hero-slider__dot" data-hero-dot aria-label="Слайд 2" aria-current="false"></button>
                <button type="button" class="hero-slider__dot" data-hero-dot aria-label="Слайд 3" aria-current="false"></button>
                <button type="button" class="hero-slider__dot" data-hero-dot aria-label="Слайд 4" aria-current="false"></button>
            </div>
        </div>
    </section>
}

<section class="movies-section">
    <div class="movies-container">
        <h2 class="section-title">@Model.Title</h2>
        @if (Model.Films.Count == 0)
        {
            <p class="shell-placeholder">@Model.EmptyMessage</p>
        }
        else
        {
            <div class="movies-grid">
                @foreach (var film in Model.Films)
                {
                    <a asp-controller="Movies" asp-action="Details" asp-route-id="@film.Id" class="film-card-link">
                        <article class="movie-card">
                            <div class="movie-poster">
                                <img src="@film.PosterPath" alt="@film.Title poster">
                            </div>
                            <div class="movie-meta">
                                <h3>@film.Title</h3>
                                <div class="session-times">@film.SessionSummary</div>
                            </div>
                            <button class="btn btn-primary w-100" type="button">КУПИТИ КВИТОК</button>
                        </article>
                    </a>
                }
            </div>
        }
    </div>
</section>
