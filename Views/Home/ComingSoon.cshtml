@model MovieCatalogueViewModel
@{
    ViewData["Title"] = "Скоро";
}

<section class="movies-section">
    <div class="movies-container">
        <h2 class="section-title">@Model.Title</h2>
        @if (Model.Films.Count == 0)
        {
            <p class="shell-placeholder">@Model.EmptyMessage</p>
        }
        else
        {
            <div class="movies-grid">
                @foreach (var film in Model.Films)
                {
                    <a asp-controller="Movies" asp-action="Details" asp-route-id="@film.Id" class="film-card-link">
                        <article class="movie-card">
                            <div class="movie-poster">
                                <img src="@film.PosterPath" alt="@film.Title poster">
                            </div>
                            <div class="movie-meta">
                                <h3>@film.Title</h3>
                                <div class="session-times">@film.SessionSummary</div>
                            </div>
                            <span class="btn btn-primary w-100 movie-card__coming-soon">ДЕТАЛЬНІШЕ</span>
                        </article>
                    </a>
                }
            </div>
        }
    </div>
</section>
